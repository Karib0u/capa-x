{
  "name": "capa-x-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "sh scripts/build-wasm.sh",
    "pack-rules": "node scripts/pack-rules.mjs",
    "prepare-assets": "npm run build:wasm && npm run pack-rules",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.152.0"
  }
}
